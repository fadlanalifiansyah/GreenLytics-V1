<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.progress.ProgressFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/tv_progress_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:text="Progress"
            android:fontFamily="@font/poppins_bold"
            android:textSize="24sp"
            android:textColor="#101820"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_progress_subheader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="4dp"
            android:text="Konsistensimu membuahkan hasil"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"
            android:textColor="#757575"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_progress_header" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_streak_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/primary"
            app:layout_constraintTop_toBottomOf="@id/tv_progress_subheader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_streak_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <View
                    android:id="@+id/v_streak_icon_bg"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_circle_glass"
                    android:backgroundTint="@color/surface"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:srcCompat="@drawable/ic_fire"
                    app:tint="@color/warning"
                    app:layout_constraintBottom_toBottomOf="@id/v_streak_icon_bg"
                    app:layout_constraintEnd_toEndOf="@id/v_streak_icon_bg"
                    app:layout_constraintStart_toStartOf="@id/v_streak_icon_bg"
                    app:layout_constraintTop_toTopOf="@id/v_streak_icon_bg" />

                <TextView
                    android:id="@+id/tv_streak_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="7 Hari"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toEndOf="@id/v_streak_icon_bg"
                    app:layout_constraintTop_toTopOf="@id/v_streak_icon_bg" />

                <TextView
                    android:id="@+id/tv_streak_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Streak aktif berturut-turut"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toEndOf="@id/v_streak_icon_bg"
                    app:layout_constraintTop_toBottomOf="@id/tv_streak_title" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_progress_bar_container"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#33FFFFFF"
                    app:layout_constraintTop_toBottomOf="@+id/tv_streak_subtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_streak_target">

                    <ProgressBar
                        android:id="@+id/pbStreak"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:progress="50"
                        android:progressTint="@color/warning"
                        android:background="@android:color/transparent"
                        android:scaleY="10" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_streak_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7/30 hari"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    app:layout_constraintBottom_toBottomOf="@id/cv_progress_bar_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/cv_progress_bar_container" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_koleksi_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Semua Badge"
            android:fontFamily="@font/poppins_bold"
            android:textSize="16sp"
            android:textColor="#101820"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cv_streak_card" />

        <HorizontalScrollView
            android:id="@+id/hsv_badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingHorizontal="24dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/tv_koleksi_title">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Badge 1 -->
                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_badge_grid_item"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">
                        <View
                            android:id="@+id/bg_badge1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_glass"
                            android:backgroundTint="#EEEEEE"/>
                        <ImageView
                            android:id="@+id/iv_badge1"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_badge1"
                            app:tint="#9E9E9E" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Pemula\nHijau"
                        android:textColor="#101820"
                        android:textSize="11sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/poppins_bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="3 hari"
                        android:textColor="#757575"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Badge 2 -->
                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_badge_grid_item"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">
                        <View
                            android:id="@+id/bg_badge2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_glass"
                            android:backgroundTint="#EEEEEE"/>
                        <ImageView
                            android:id="@+id/iv_badge2"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_badge2"
                            app:tint="#9E9E9E" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Pejuang\nIklim"
                        android:textColor="#101820"
                        android:textSize="11sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/poppins_bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="7 hari"
                        android:textColor="#757575"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Badge 3 -->
                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_badge_grid_item"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">
                        <View
                            android:id="@+id/bg_badge3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_glass"
                            android:backgroundTint="#EEEEEE"/>
                        <ImageView
                            android:id="@+id/iv_badge3"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_badge3"
                            app:tint="#9E9E9E" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Eco\nChampion"
                        android:textColor="#101820"
                        android:textSize="11sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/poppins_bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="14 hari"
                        android:textColor="#757575"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Badge 4 -->
                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_badge_grid_item"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">
                        <View
                            android:id="@+id/bg_badge4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_glass"
                            android:backgroundTint="#EEEEEE"/>
                        <ImageView
                            android:id="@+id/iv_badge4"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_badge4"
                            app:tint="#9E9E9E" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Guardian\nBumi"
                        android:textColor="#101820"
                        android:textSize="11sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/poppins_bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="30 hari"
                        android:textColor="#757575"
                        android:textSize="9sp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_chart_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_white_outline"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/hsv_badges"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_chart_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tren Emisi Mingguan"
                android:fontFamily="@font/poppins_bold"
                android:textSize="16sp"
                android:textColor="#101820"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_chart_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_line"
                android:backgroundTint="#E0E0E0"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="7 Hari"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#757575"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/tv_chart_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_chart_title" />

            <com.github.mikephil.charting.charts.CombinedChart
                android:id="@+id/combinedChart"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_chart_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>