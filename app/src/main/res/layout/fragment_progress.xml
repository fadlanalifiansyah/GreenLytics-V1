<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.progress.ProgressFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/tv_progress_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:text="Progress"
            android:fontFamily="@font/poppins_bold"
            android:textSize="24sp"
            android:textColor="#101820"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_progress_subheader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="4dp"
            android:text="Konsistensimu membuahkan hasil"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"
            android:textColor="#757575"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_progress_header" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_streak_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_light_green"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/tv_progress_subheader">

            <View
                android:id="@+id/v_streak_icon_bg"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_glass"
                android:backgroundTint="@color/surface"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:srcCompat="@drawable/ic_fire"
                app:tint="@color/warning"
                app:layout_constraintBottom_toBottomOf="@id/v_streak_icon_bg"
                app:layout_constraintEnd_toEndOf="@id/v_streak_icon_bg"
                app:layout_constraintStart_toStartOf="@id/v_streak_icon_bg"
                app:layout_constraintTop_toTopOf="@id/v_streak_icon_bg" />

            <TextView
                android:id="@+id/tv_streak_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="7 Hari"
                android:fontFamily="@font/poppins_bold"
                android:textSize="24sp"
                android:textColor="@color/white"
                app:layout_constraintStart_toEndOf="@id/v_streak_icon_bg"
                app:layout_constraintTop_toTopOf="@id/v_streak_icon_bg" />

            <TextView
                android:id="@+id/tv_streak_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Streak aktif berturut-turut"
                android:fontFamily="@font/poppins_medium"
                android:textSize="12sp"
                android:textColor="@color/secondary"
                app:layout_constraintStart_toEndOf="@id/v_streak_icon_bg"
                app:layout_constraintTop_toBottomOf="@id/tv_streak_title" />

            <ProgressBar
                android:id="@+id/pb_streak"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:progress="50"
                android:progressTint="@color/warning"
                app:layout_constraintEnd_toStartOf="@id/tv_streak_target"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/v_streak_icon_bg" />

            <TextView
                android:id="@+id/tv_streak_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7/14 hari"
                android:fontFamily="@font/poppins_medium"
                android:textSize="10sp"
                android:textColor="@color/secondary"
                app:layout_constraintBottom_toBottomOf="@id/pb_streak"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/pb_streak" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_koleksi_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Semua Badge"
            android:fontFamily="@font/poppins_bold"
            android:textSize="16sp"
            android:textColor="#101820"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_streak_card" />

        <HorizontalScrollView
            android:id="@+id/hsv_badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingHorizontal="24dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/tv_koleksi_title">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_badge_grid_item"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_glass"
                            android:backgroundTint="#E3F2FD"/>
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_badge1" app:tint="#1976D2" /> </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Pemula\nHijau"
                        android:textColor="#101820"
                        android:textSize="11sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/poppins_bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 hari"
                        android:textColor="#757575"
                        android:textSize="9sp"
                        android:fontFamily="@font/poppins_medium"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_badge_grid_item"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_glass"
                            android:backgroundTint="#FFF3E0"/>
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_badge2" app:tint="@color/warning" /> </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Pejuang\nIklim"
                        android:textColor="#101820"
                        android:textSize="11sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/poppins_bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 hari"
                        android:textColor="#757575"
                        android:textSize="9sp"
                        android:fontFamily="@font/poppins_medium"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_badge_grid_item"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_glass"
                            android:backgroundTint="#E0F2F1"/>
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_badge3" app:tint="#00796B" /> </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Eco\nChampion"
                        android:textColor="#101820"
                        android:textSize="11sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/poppins_bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14 hari"
                        android:textColor="#757575"
                        android:textSize="9sp"
                        android:fontFamily="@font/poppins_medium"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="120dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_badge_grid_item"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_glass"
                            android:backgroundTint="#F3E5F5"/>
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_badge4" app:tint="#7B1FA2" /> </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Guardian\nBumi"
                        android:textColor="#101820"
                        android:textSize="11sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/poppins_bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 hari"
                        android:textColor="#757575"
                        android:textSize="9sp"
                        android:fontFamily="@font/poppins_medium"/>
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_chart_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_white_outline"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/hsv_badges"
            tools:ignore="ExtraText">

            <TextView
                android:id="@+id/tv_chart_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tren Emisi Mingguan"
                android:fontFamily="@font/poppins_bold"
                android:textSize="16sp"
                android:textColor="#101820"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_chart_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_line"
                android:backgroundTint="#E0E0E0"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="7 Hari"
                android:fontFamily="@font/poppins_medium"
                android:textColor="#757575"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/tv_chart_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_chart_title" />

            <com.github.mikephil.charting.charts.CombinedChart
                android:id="@+id/combinedChart"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:minHeight="250dp"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/tv_chart_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>